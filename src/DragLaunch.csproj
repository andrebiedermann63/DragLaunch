<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DragLaunch</AssemblyName>
    <RootNamespace>DragLaunch</RootNamespace>
    <Version>24.0.0</Version>
    <Product>DragLaunch</Product>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <ApplicationIcon>DragLaunch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="DragLaunch.ico" />
    <Resource Include="DragLaunch256.png" />
    <None Update="Sound\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
