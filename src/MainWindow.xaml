<Window x:Class="DragLaunch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DragLaunch" Icon="DragLaunch.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Grid x:Name="RootGrid">
        <Border x:Name="FrameBorder" CornerRadius="9" Padding="7,4,7,7"
                MouseLeftButtonDown="Frame_MouseLeftButtonDown"
                MouseRightButtonUp="Frame_MouseRightButtonUp">
            <DockPanel>
                <Grid x:Name="TabBar" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MenuButton" Width="26" Margin="0,0,4,0" CornerRadius="4"
                            Background="Transparent" Cursor="Hand" ToolTip="Menü"
                            MouseLeftButtonUp="MenuButton_Click">
                        <TextBlock x:Name="MenuGlyph" Text="&#x2261;" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <UniformGrid x:Name="TabStrip" Grid.Column="1" Rows="1"/>
                </Grid>
                <Border x:Name="CanvasBorder" CornerRadius="5" Margin="0,4,0,0" Padding="4">
                    <Canvas x:Name="ItemCanvas" ClipToBounds="True" Background="Transparent" AllowDrop="True"
                            DragOver="Canvas_DragOver" DragLeave="Canvas_DragLeave" Drop="Canvas_Drop"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseRightButtonUp="Canvas_MouseRightButtonUp"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Greifer zum Vergrössern (Fenster bleibt links/unten verankert) -->
        <Border x:Name="GripRight" Tag="R" Width="7" HorizontalAlignment="Right" Background="Transparent"
                Cursor="SizeWE" ToolTip="Spalten hinzufügen/entfernen" MouseLeftButtonDown="Grip_MouseDown"/>
        <Border x:Name="GripTop" Tag="T" Height="5" VerticalAlignment="Top" Background="Transparent"
                Cursor="SizeNS" ToolTip="Zeilen hinzufügen/entfernen" MouseLeftButtonDown="Grip_MouseDown"/>
        <Border x:Name="GripCorner" Tag="TR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="Grip_MouseDown"/>

        <!-- Ebene für das gezogene Icon -->
        <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
    </Grid>
</Window>
